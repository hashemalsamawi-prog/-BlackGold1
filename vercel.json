{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|images|assets|uploads|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
